# =====================================================================
# DocuMind AI — Environment Configuration Template
# =====================================================================

# ---------------------------------------------------------------------
# BACKEND HOST ENVIRONMENT VARIABLES
# (Configure on Render, Railway, Fly.io, Cloud Run, or Node.js VPS)
# ---------------------------------------------------------------------

# Gemini AI API Key (required for embeddings and grounded answers)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PostgreSQL Database with pgvector (e.g. Supabase or self-hosted PostgreSQL 15+)
# Format: postgresql://[user]:[password]@[host]:5432/[database]
# If omitted, DocuMind AI automatically uses its embedded pgvector-compatible hybrid engine
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Allowed CORS Origins (comma-separated if multiple)
# Set this to your deployed Netlify domain (e.g. https://documind-ai.netlify.app)
# Use * for development or permissive access
CORS_ORIGIN="https://your-site.netlify.app"

# Server Port (assigned automatically by Render/Railway/Fly/Cloud Run, or default 3000)
PORT=3000

# Crawler & Retrieval Tuning
CRAWL_MAX_CONCURRENCY=5
CRAWL_DEFAULT_MAX_PAGES=20
CRAWL_REQUEST_TIMEOUT_MS=12000
EMBEDDING_MODEL="gemini-embedding-2-preview"
COMPLETION_MODEL="gemini-3.8-flash"

# ---------------------------------------------------------------------
# FRONTEND / NETLIFY ENVIRONMENT VARIABLES
# (Configure in Netlify Site Settings > Environment Variables)
# ---------------------------------------------------------------------

# The public URL of your deployed backend service (e.g. Render, Railway, Cloud Run)
# Must start with VITE_ to be exposed to client-side Vite bundles.
# If using Netlify's proxy redirect (/api/* -> backend/api/*), you can leave this empty.
VITE_API_BASE_URL="https://your-backend-api.onrender.com"
